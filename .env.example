APP_NAME="KADIN Digital Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=magang
DB_USERNAME=postgres
DB_PASSWORD=Zanuar24

SESSION_DRIVER=database
SESSION_LIFETIME=120
FILESYSTEM_DISK=public

# Konfigurasi MinIO (S3-Compatible Object Storage)
# Jika belum diisi, aplikasi otomatis fallback ke disk 'public' lokal
MINIO_ENDPOINT=
MINIO_KEY=
MINIO_SECRET=
MINIO_BUCKET=
MINIO_REGION=us-east-1

# CORS Allowed Origin (Frontend URL)
FRONTEND_URL=http://localhost:5500

# Fase 3: AI & WhatsApp Gateway (OpenRouter & Wablas)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free
WABLAS_TOKEN=
